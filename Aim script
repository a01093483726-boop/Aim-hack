local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local runService = game:GetService("RunService")

-- UI가 이미 있다면 제거
if player.PlayerGui:FindFirstChild("LookAtGui") then
    player.PlayerGui.LookAtGui:Destroy()
end

-- ScreenGui 생성
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LookAtGui"
screenGui.Parent = player.PlayerGui

-- 네모난 스위치 버튼 만들기
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 90, 0, 45) -- 네모난 직사각형 모양
toggleButton.Position = UDim2.new(0.85, 0, 0.15, 0) -- 화면 우측 상단
toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleButton.BorderSizePixel = 2
toggleButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.Text = "OFF\n(캐릭시선고정)"
toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
toggleButton.TextSize = 12
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = screenGui

-- 모서리가 약간 둥근 네모 모양 (UICorner)
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = toggleButton

-- 상태 변수 및 타겟 변수
local isOn = false
local lockedTarget = nil

-- 버튼 클릭 이벤트 (ON / OFF 토글)
toggleButton.MouseButton1Click:Connect(function()
    isOn = not isOn
    if isOn then
        toggleButton.Text = "ON\n(캐릭시선고정)"
        toggleButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(20, 80, 20)
        print("캐릭터 시선 고정 켜짐 (바라볼 상대를 클릭하세요)")
    else
        toggleButton.Text = "OFF\n(캐릭시선고정)"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        lockedTarget = nil
        print("캐릭터 시선 고정 꺼짐")
    end
end)

-- 화면을 클릭했을 때 바라볼 상대 지정
mouse.Button1Down:Connect(function()
    if isOn then
        local target = mouse.Target
        if target and target.Parent then
            local character = target.Parent
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and game.Players:GetPlayerFromCharacter(character) and game.Players:GetPlayerFromCharacter(character) ~= player then
                lockedTarget = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
                print("바라볼 대상 지정됨: " .. character.Name)
            end
        end
    end
end)

-- 매 프레임마다 내 캐릭터가 상대를 바라보게 회전시킴 (카메라는 자유로움!)
runService.RenderStepped:Connect(function()
    if isOn and lockedTarget and lockedTarget.Parent then
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local rootPart = character.HumanoidRootPart
            -- 내 캐릭터의 위치에서 상대방 위치를 바라보는 방향 계산 (Y축 높이는 유지해서 땅에 박히지 않게 함)
            local targetPos = Vector3.new(lockedTarget.Position.X, rootPart.Position.Y, lockedTarget.Position.Z)
            rootPart.CFrame = CFrame.new(rootPart.Position, targetPos)
        end
    end
end)

print("캐릭터 시선 고정 네모 스위치 생성 완료!")
