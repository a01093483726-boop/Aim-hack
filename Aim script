-- [3] 벽 뒤에 있는지 확인하는 함수 (Raycast 활용)
local function isVisible(targetPart)
    local character = player.Character
    if not character or not character:FindFirstChild("Head") then return false end
    
    local origin = character.Head.Position
    local destination = targetPart.Position
    local direction = destination - origin

    -- 레이캐스트 파라미터 설정 (내 캐릭터와 적 자신은 무시하고 장애물만 감지)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local ignoreList = {character}
    if targetPart.Parent then
        table.insert(ignoreList, targetPart.Parent)
    end
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.IgnoreWater = true

    -- 레이저를 쏴서 사이에 벽이 있는지 검사
    local result = workspace:Raycast(origin, direction, raycastParams)
    
    -- 결과가 없으면(사이에 가로막는 벽이 없으면) true 반환
    if result == nil then
        return true
    else
        return false -- 벽에 막힘!
    end
end

-- [4] 매 프레임 검사: 원 안 + 벽 뒤가 아닐 때만 작동
runService.RenderStepped:Connect(function()
    if not isOn then return end

    local closestTarget = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local circleRadius = 25 -- 중앙 원의 반지름 (Size 50 기준)

    for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local char = otherPlayer.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen then
                    local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (screenPos - screenCenter).Magnitude

                    -- [조건 1] 중앙 원 안에 있고, [조건 2] 벽 뒤에 숨어있지 않고 실제로 눈앞에 보일 때만!
                    if distance <= circleRadius and distance < shortestDistance then
                        if isVisible(targetPart) then
                            shortestDistance = distance
                            closestTarget = targetPart
                        end
                    end
                end
            end
        end
    end

    -- 타겟이 조건에 맞을 때만 카메라 시점 대신 타겟팅 데이터 유지 (사일런트 에임 연동)
    if closestTarget and closestTarget.Parent then
        -- 화면 전체가 홱 안 돌아가고, 원 안의 보이는 적에게만 판정이 집중됩니다.
        local camPos = camera.CFrame.Position
        camera.CFrame = CFrame.new(camPos, closestTarget.Position)
    end
end)

