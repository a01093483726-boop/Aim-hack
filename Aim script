local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local camera = workspace.CurrentCamera
local runService = game:GetService("RunService")

-- ScreenGui 생성 (고유한 이름 사용)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AimBotUniqueGui_2026"
screenGui.Parent = player.PlayerGui

-- 네모난 스위치 버튼 만들기
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 90, 0, 45) -- 네모난 직사각형 모양
toggleButton.Position = UDim2.new(0.85, 0, 0.15, 0) -- 화면 우측 상단
toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleButton.BorderSizePixel = 2
toggleButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.Text = "OFF\n(에임봇)"
toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
toggleButton.TextSize = 12
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Parent = screenGui

-- 모서리가 약간 둥근 네모 모양 (UICorner)
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = toggleButton

-- 상태 변수 및 타겟 변수
local isOn = false
local lockedTarget = nil

-- 버튼 클릭 이벤트 (ON / OFF 토글)
toggleButton.MouseButton1Click:Connect(function()
    isOn = not isOn
    if isOn then
        toggleButton.Text = "ON\n(에임봇)"
        toggleButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(20, 80, 20)
        print("에임봇 켜짐 (조준할 상대를 클릭하세요)")
    else
        toggleButton.Text = "OFF\n(에임봇)"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        lockedTarget = nil
        print("에임봇 꺼짐")
    end
end)

-- 화면을 클릭했을 때 조준할 상대 지정
mouse.Button1Down:Connect(function()
    if isOn then
        local target = mouse.Target
        if target and target.Parent then
            local character = target.Parent
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and game.Players:GetPlayerFromCharacter(character) and game.Players:GetPlayerFromCharacter(character) ~= player then
                -- 상대방의 머리(Head)를 정중앙 타겟으로 지정
                lockedTarget = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                print("에임봇 타겟 지정됨: " .. character.Name)
            end
        end
    end
end)

-- 매 프레임마다 상대방이 화면 정중앙에 오도록 카메라 고정
runService.RenderStepped:Connect(function()
    if isOn and lockedTarget and lockedTarget.Parent then
        local char = lockedTarget.Parent
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        
        -- 상대가 죽었거나 사라졌으면 타겟 해제
        if not humanoid or humanoid.Health <= 0 then
            lockedTarget = nil
            return
        end

        -- 카메라 위치는 유지하고 시선만 상대방 머리를 향하게 함
        local camPos = camera.CFrame.Position
        camera.CFrame = CFrame.new(camPos, lockedTarget.Position)
    end
end)

print("에임봇 네모 스위치 생성 완료!")
