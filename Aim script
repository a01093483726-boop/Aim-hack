local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 다른 플레이어 캐릭터에 외곽선(Highlight)과 이름표를 생성하는 함수
local function createESP(character, player)
    if not character then return end
    
    -- 1. 캐릭터 외곽선 표시 (Highlight)
    if not character:FindFirstChild("StandardHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "StandardHighlight"
        highlight.FillColor = Color3.fromRGB(0, 150, 255) -- 내부 색상
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- 외곽선 색상
        highlight.OutlineTransparency = 0
        highlight.Adornee = character
        highlight.Parent = character
    end
    
    -- 2. 머리 위에 플레이어 이름 표시 (BillboardGui)
    local head = character:WaitForChild("Head", 5)
    if head and not head:FindFirstChild("NameTagGui") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "NameTagGui"
        billboard.Size = UDim2.new(0, 100, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0) -- 머리 위 높이 조절
        billboard.AlwaysOnTop = true
        billboard.Adornee = head
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = player.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = billboard
        
        billboard.Parent = head
    end
end

-- 이미 접속해 있는 플레이어들 처리
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        if player.Character then
            createESP(player.Character, player)
        end
        player.CharacterAdded:Connect(function(character)
            createESP(character, player)
        end)
    end
end

-- 새로 접속하는 플레이어들 처리
Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function(character)
            createESP(character, player)
        end)
